{
  "name": "@masia/demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The playground of the open Masia messenger: one command, two browser tabs, an end-to-end encrypted chat through a local relay. No Masia brain, no account system.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "tsx server/main.ts",
